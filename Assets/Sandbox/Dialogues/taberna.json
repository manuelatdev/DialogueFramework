{
  "version": 1,
  "start": "n_inicio",
  "nodes": [
    { "id": "n_inicio", "title": "Recibimiento", "type": "line",
      "line": { "text": "No servimos a desconocidos.", "speaker": "Tabernero" },
      "editor": { "x": 0, "y": 0 },
      "out": [ { "to": "n_menu" } ] },

    { "id": "n_menu", "title": "Reacción", "type": "choice",
      "editor": { "x": 260, "y": 0 },
      "out": [
        { "to": "n_info", "id": "info",
          "line": { "text": "Solo quiero información." } },

        { "to": "n_pago", "id": "pagar",
          "line": { "text": "Pago lo que haga falta. (30 de oro)" },
          "when": { "var": "oro", "op": ">=", "value": 30 },
          "then": [
            { "var": "oro", "op": "-=", "value": 30 },
            { "command": "sonar_monedas", "args": [ "bolsa" ] }
          ] },

        { "to": "n_amenaza", "id": "amenazar",
          "line": { "text": "Aparta de mi camino." },
          "when": { "var": "reputacion", "op": "<", "value": 0 },
          "hideWhenUnavailable": true }
      ] },

    { "id": "n_info", "type": "line",
      "line": { "text": "Pues busca en otra parte.", "speaker": "Tabernero" },
      "editor": { "x": 520, "y": -120 },
      "out": [ { "to": "n_fin" } ] },

    { "id": "n_pago", "type": "line",
      "line": { "text": "Así me gusta. Sube al desván.", "speaker": "Tabernero" },
      "editor": { "x": 520, "y": 0 },
      "out": [ { "to": "n_fin" } ] },

    { "id": "n_amenaza", "type": "line",
      "line": { "text": "Inténtalo y verás.", "speaker": "Tabernero" },
      "editor": { "x": 520, "y": 120 },
      "out": [ { "to": "n_fin" } ] },

    { "id": "n_fin", "type": "hub", "fallthrough": "end",
      "editor": { "x": 780, "y": 0 },
      "out": [] }
  ]
}